{
  "expo": {
    "name": "Openminerals Demo",
    "slug": "openminerals-demo",
    "scheme": "openminerals-demo",
    "version": "0.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#090F15",
    "icon": "./assets/icon.png",
    "runtimeVersion": { "policy": "appVersion" },
    "updates": {
      "url": "https://u.expo.dev/c3985e04-43dd-4896-9f8a-09366b6a3579",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.openminerals.demo.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.openminerals.demo.mobile",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#090F15"
      }
    },
    "plugins": [
      ["expo-secure-store", {"configureAndroidBackup": true, "faceIDPermission": false}]
    ],
    "extra": {
      "demoOnly": true,
      "eas": {
        "projectId": "c3985e04-43dd-4896-9f8a-09366b6a3579"
      }
    },
    "owner": "chipirips-team"
  }
}
