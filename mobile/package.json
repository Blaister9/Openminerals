    "check:toolchain": "node scripts/patch-toolchain.mjs --check"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.17",
    "expo-crypto": "~57.0.3",
    "expo-gl": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "@types/react": "~19.2.2",
    "react-dom": "19.2.3",
    "react-native-web": "^0.21.2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13"
  },
