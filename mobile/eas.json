{
  "cli": { "version": ">= 18.0.0", "appVersionSource": "local" },
  "build": {
    "market-reference": {
      "environment": "preview",
      "channel": "market-reference",
      "distribution": "internal",
      "env": {
        "OPENMINERALS_MARKET_PREVIEW": "1",
        "EXPO_PUBLIC_MARKET_REFERENCE": "1",
        "EXPO_PUBLIC_API_URL": "https://openminerals-market-api-market-reference.up.railway.app"
      },
      "android": { "buildType": "apk" }
    },
    "development": { "developmentClient": true, "distribution": "internal" },
    "preview": {
      "environment": "preview",
      "channel": "demo",
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_URL": "https://openminerals-api-demo.up.railway.app" },
      "android": { "buildType": "apk" }
    },
    "release-demo": { "extends": "preview", "android": { "buildType": "apk" } },
    "ios-simulator": { "extends": "preview", "ios": { "simulator": true } },
    "production": {}
  },
  "submit": { "production": {} }
}
