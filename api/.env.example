# Railway: referenciar la variable DATABASE_URL del servicio PostgreSQL.
# En Railway configurar REQUIRE_DATABASE=true para no usar memoria por error.
PORT=3000
REQUIRE_DATABASE=false
# Independent notifications preview only; no change to existing Railway services.
DEMO_NOTIFICATIONS_ENABLED=false
DEMO_PUSH_SEND_ENABLED=false
