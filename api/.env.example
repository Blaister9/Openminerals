# Railway: referenciar la variable DATABASE_URL del servicio PostgreSQL.
# En Railway configurar REQUIRE_DATABASE=true para no usar memoria por error.
PORT=3000
REQUIRE_DATABASE=false
# Base Sepolia DEMO only, in a NEW isolated API/database. No private keys.
DEMO_BASE_SEPOLIA_ENABLED=false
# TESTNET_ORIGIN=https://your-isolated-testnet-api.example
TESTNET_CONFIRMATIONS=3
# DATABASE_URL=postgresql://...
# DEMO_ADMIN_TOKEN=secret-of-at-least-32-random-characters
