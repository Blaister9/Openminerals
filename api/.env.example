# Railway: referenciar la variable DATABASE_URL del servicio PostgreSQL.
# En Railway configurar REQUIRE_DATABASE=true para no usar memoria por error.
PORT=3000
REQUIRE_DATABASE=false
# DATABASE_URL=postgresql://...
# DEMO_ADMIN_TOKEN=secret-of-at-least-32-random-characters

# Optional market references. Keep off on the stable commercial deployment.
MARKET_REFERENCE_ENABLED=false
# Server secret only. Never EXPO_PUBLIC_ and never committed.
# METALS_DEV_API_KEY=
# Confirm mobile display, caching and derived quote retention rights first.
MARKET_METALS_STORAGE_ALLOWED=false
MARKET_CACHE_SECONDS=300
MARKET_METALS_DAILY_LIMIT=20
MARKET_METALS_MONTHLY_LIMIT=100
MARKET_QUOTE_TTL_SECONDS=90
MARKET_BUY_SPREAD_BPS=100
MARKET_SELL_SPREAD_BPS=100
MARKET_BUY_FEE_BPS=100
MARKET_SELL_FEE_BPS=120
